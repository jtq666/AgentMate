OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
USE_LOCAL_EMBEDDING=true
S2_API_KEY=your-semantic-scholar-key
AGENTMATE_HOST=127.0.0.1
AGENTMATE_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
AGENTMATE_API_URL=http://localhost:8000
# 可选：覆盖运行数据目录，便于测试隔离或容器持久化
AGENTMATE_MEMORY_DIR=F:\path\to\agentmate-data\memory
AGENTMATE_KB_PERSIST_DIR=F:\path\to\agentmate-data\knowledge
AGENTMATE_EVALUATION_PATH=F:\path\to\agentmate-data\evaluation.json
AGENTMATE_STUDY_DB_PATH=F:\path\to\agentmate-data\agentmate.db
AGENTMATE_STAGE_TIMEOUT_SECONDS=90
AGENTMATE_STAGE_MAX_RETRIES=1
# Windows 多个目录使用分号分隔；目录导入只允许访问这些根目录
AGENTMATE_IMPORT_ROOTS=F:\path\to\your\knowledge
